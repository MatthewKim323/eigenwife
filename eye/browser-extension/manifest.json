{
  "manifest_version": 3,
  "name": "Eye DOM Selector",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Local gaze highlighting and explicit DOM selection on a tab you enable.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Eye DOM Selector"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8765 ws://127.0.0.1:8767"}
}
